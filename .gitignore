# dependencies
node_modules/

# build output
dist/
coverage/

# logs & OS files
*.log
npm-debug.log*
.DS_Store

# drizzle metadata: the journal and snapshots MUST be committed, otherwise
# `drizzle-kit migrate` has no migration order on a fresh clone (deploy hosts).
# Only the transient artifacts are ignored.
drizzle/meta/*.json.tmp
drizzle/meta/README.md

# environment files (never commit secrets)
.env
.env.*
!.env.example

# typescript build cache
*.tsbuildinfo

# credentials / keys
*.pem
*.p12
*.key
