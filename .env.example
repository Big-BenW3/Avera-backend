NODE_ENV=development
PORT=4000
API_ORIGIN=http://localhost:4000
WEB_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# Neon PostgreSQL: copy the Node.js connection string from Neon Connect.
DATABASE_URL=postgresql://USER:PASSWORD@NEON_HOST/NEON_DATABASE?sslmode=require

# Upstash Redis: copy the ioredis TLS connection URL from Redis Connect.
REDIS_URL=rediss://:UPSTASH_PASSWORD@UPSTASH_HOST:UPSTASH_PORT

# Self-managed authentication: generate with `openssl rand -base64 48`.
AUTH_JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SERVER_ONLY_SECRET
AUTH_SESSION_TTL_HOURS=168
AUTH_REFRESH_TTL_DAYS=30
AUTH_COOKIE_NAME=buildspace_session
AUTH_SECURE_COOKIES=false

# Optional S3-compatible attachment storage
S3_REGION=us-east-1
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional LiveKit calls; server-side values only
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional NVIDIA NIM AI; server-side values only
NVIDIA_NIM_BASE_URL=
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_MODEL_ID=

# Optional future OAuth provider settings; server-side values only
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=