{
  "name": "buildspace-api",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone Buildspace backend API. It has no Manus-specific runtime, credentials, or dependencies.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "openapi": "tsx src/openapi.ts",
    "worker": "tsx src/jobs/worker.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.840.0",
    "@aws-sdk/s3-request-presigner": "^3.840.0",
    "@hono/node-server": "^2.1.1",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.1.1",
    "argon2": "^0.44.0",
    "bullmq": "^5.58.0",
    "dotenv": "^17.2.2",
    "drizzle-orm": "^0.44.5",
    "hono": "^4.8.9",
    "ioredis": "^5.6.1",
    "jose": "^6.1.0",
    "livekit-server-sdk": "^2.13.0",
    "nanoid": "^5.1.5",
    "otpauth": "^9.4.1",
    "pg": "^8.16.3",
    "pino": "^9.7.0",
    "pino-http": "^10.5.0",
    "zod": "^4.0.15"
  },
  "devDependencies": {
    "@types/node": "^22.15.32",
    "@types/pg": "^8.15.4",
    "@types/ws": "^8.5.13",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4",
    "ws": "^8.18.2"
  }
}
